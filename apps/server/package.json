{
  "name": "@luvia/server",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node src/dev.ts",
    "start:api": "node src/api/main.ts",
    "start:worker": "node src/worker/main.ts",
    "bench": "node scripts/seed-bench.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "@luvia/contracts": "workspace:*",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "exifr": "7.1.3",
    "fastify": "5.12.8",
    "jsonwebtoken": "9.0.3",
    "kysely": "0.29.8",
    "mime-types": "3.0.2",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "thumbhash": "0.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
